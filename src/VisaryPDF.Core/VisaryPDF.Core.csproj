<Project Sdk="Microsoft.NET.Sdk">
  <!-- PDF engine: a thin, AOT friendly wrapper over PDFium. No UI and no Windows APIs, so it is testable anywhere. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>VisaryPDF.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="VisaryPDF.Core.Tests" />
  </ItemGroup>
</Project>
