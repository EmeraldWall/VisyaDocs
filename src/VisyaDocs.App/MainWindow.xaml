<Window
    x:Class="VisyaDocs.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="VisyaDocs">

    <Grid x:Name="Root" Background="{ThemeResource VisyaWindowBrush}" AllowDrop="True"
          DragOver="Root_DragOver" Drop="Root_Drop" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="O" Invoked="OpenAccelerator_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="W" Invoked="CloseTabAccelerator_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="Tab" Invoked="NextTabAccelerator_Invoked" />
            <KeyboardAccelerator Key="F11" Invoked="FullScreenAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleRow" Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
          Title bar: exactly the height of the caption buttons. The whole row is the drag area;
          tabs and the menu button are carved out as clickable (pass-through) regions in code.
        -->
        <Grid x:Name="AppTitleBar" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="48" />
                <ColumnDefinition x:Name="CaptionInset" Width="138" />
            </Grid.ColumnDefinitions>
            <Image Source="ms-appx:///Assets/AppLogo.png" Width="16" Height="16" Margin="12,0,8,0" VerticalAlignment="Center" />

            <StackPanel x:Name="TitleInteractive" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch">
                <Button x:Name="MenuButton" Style="{StaticResource TitleBarButtonStyle}" ToolTipService.ToolTip="Menu">
                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                    <Button.Flyout>
                        <MenuFlyout x:Name="AppMenu" Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem Text="Open PDF..." Click="Open_Click" KeyboardAcceleratorTextOverride="Ctrl+O">
                                <MenuFlyoutItem.Icon><ImageIcon Source="ms-appx:///Assets/Icons/open.png" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSubItem x:Name="RecentMenu" Text="Recent">
                                <MenuFlyoutSubItem.Icon><ImageIcon Source="ms-appx:///Assets/Icons/recent.png" /></MenuFlyoutSubItem.Icon>
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Images to PDF..." Click="ImagesToPdf_Click">
                                <MenuFlyoutItem.Icon><ImageIcon Source="ms-appx:///Assets/Icons/create.png" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Merge PDFs..." Click="MergePdfs_Click">
                                <MenuFlyoutItem.Icon><ImageIcon Source="ms-appx:///Assets/Icons/merge.png" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutSubItem Text="Theme">
                                <MenuFlyoutSubItem.Icon><ImageIcon Source="ms-appx:///Assets/Icons/theme.png" /></MenuFlyoutSubItem.Icon>
                                <RadioMenuFlyoutItem x:Name="ThemeSystemItem" Text="System" GroupName="Theme" Click="ThemeItem_Click" Tag="System" />
                                <RadioMenuFlyoutItem x:Name="ThemeLightItem" Text="Light (soft grey)" GroupName="Theme" Click="ThemeItem_Click" Tag="Light" />
                                <RadioMenuFlyoutItem x:Name="ThemeDarkItem" Text="Dark (black and grey)" GroupName="Theme" Click="ThemeItem_Click" Tag="Dark" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutItem Text="Full screen" Click="FullScreen_Click" KeyboardAcceleratorTextOverride="F11">
                                <MenuFlyoutItem.Icon><ImageIcon Source="ms-appx:///Assets/Icons/fullscreen.png" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Settings" Click="Settings_Click">
                                <MenuFlyoutItem.Icon><ImageIcon Source="ms-appx:///Assets/Icons/settings.png" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <!-- Compact document tabs (built in code). -->
                <ScrollViewer x:Name="TabScroller" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="TabStrip" Orientation="Horizontal" Spacing="2" Margin="4,0,0,0" />
                </ScrollViewer>
                <Button x:Name="NewTabButton" Style="{StaticResource TitleBarButtonStyle}" ToolTipService.ToolTip="Open a PDF (Ctrl+O)" Click="Open_Click">
                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                </Button>
            </StackPanel>

            <TextBlock x:Name="TitleDocument" Grid.Column="2" VerticalAlignment="Center" Margin="12,0" FontSize="12"
                       Opacity="0.6" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />
        </Grid>

        <!-- Open documents; only the active one is visible. -->
        <Grid x:Name="DocumentHost" Grid.Row="1" />

        <!-- Home: shown when no document is open. -->
        <ScrollViewer x:Name="HomePanel" Grid.Row="1">
            <StackPanel MaxWidth="720" Margin="32,56,32,32" Spacing="28" HorizontalAlignment="Center">
                <StackPanel Spacing="6">
                    <Image Source="ms-appx:///Assets/AppLogo.png" Width="64" Height="64" HorizontalAlignment="Left" />
                    <TextBlock Text="VisyaDocs" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="Read, fill, sign, comment and convert PDFs. Scanned pages become searchable with the OCR built into Windows."
                               Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Style="{StaticResource HomeCardButtonStyle}" Click="Open_Click">
                        <StackPanel Spacing="10">
                            <Image Source="ms-appx:///Assets/Icons/open.png" Width="32" Height="32" HorizontalAlignment="Left" />
                            <TextBlock Text="Open PDF" FontWeight="SemiBold" />
                            <TextBlock Text="Or drop files here" Opacity="0.65" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource HomeCardButtonStyle}" Click="ImagesToPdf_Click">
                        <StackPanel Spacing="10">
                            <Image Source="ms-appx:///Assets/Icons/create.png" Width="32" Height="32" HorizontalAlignment="Left" />
                            <TextBlock Text="Images to PDF" FontWeight="SemiBold" />
                            <TextBlock Text="JPG, PNG, TIFF, HEIC" Opacity="0.65" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource HomeCardButtonStyle}" Click="MergePdfs_Click">
                        <StackPanel Spacing="10">
                            <Image Source="ms-appx:///Assets/Icons/merge.png" Width="32" Height="32" HorizontalAlignment="Left" />
                            <TextBlock Text="Merge PDFs" FontWeight="SemiBold" />
                            <TextBlock Text="Combine files into one" Opacity="0.65" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel x:Name="RecentSection" Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image Source="ms-appx:///Assets/Icons/recent.png" Width="16" Height="16" />
                        <TextBlock Text="Recent" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel x:Name="RecentList" Spacing="2" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <InfoBar x:Name="ErrorBar" Grid.Row="1" Severity="Error" IsOpen="False" VerticalAlignment="Bottom"
                 HorizontalAlignment="Center" Margin="16" MaxWidth="640" />
    </Grid>
</Window>
