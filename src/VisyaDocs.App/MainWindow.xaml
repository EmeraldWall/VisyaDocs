<Window
    x:Class="VisyaDocs.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VisyaDocs.App.Views"
    Title="VisaryPDF">

    <Grid x:Name="Root" Background="{ThemeResource VisyaWindowBrush}" AllowDrop="True"
          DragOver="Root_DragOver" Drop="Root_Drop" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="O" Invoked="OpenAccelerator_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="W" Invoked="CloseTabAccelerator_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="Tab" Invoked="NextTabAccelerator_Invoked" />
            <KeyboardAccelerator Key="F11" Invoked="FullScreenAccelerator_Invoked" />
            <KeyboardAccelerator Key="F1" Invoked="ShortcutsAccelerator_Invoked" />
            <KeyboardAccelerator Key="F6" Invoked="NextRegionAccelerator_Invoked" />
            <KeyboardAccelerator Modifiers="Shift" Key="F6" Invoked="PreviousRegionAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleRow" Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
          Title bar: exactly the height of the caption buttons. The row is the caption (drag) region;
          tabs and the menu button are carved out as clickable (pass-through) regions in code.
        -->
        <Grid x:Name="AppTitleBar" Background="Transparent" DoubleTapped="AppTitleBar_DoubleTapped">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="46" />
                <ColumnDefinition x:Name="CaptionInset" Width="138" />
            </Grid.ColumnDefinitions>
            <Image Source="ms-appx:///Assets/AppLogoSmall.png" Width="16" Height="16" Margin="12,0,8,0" VerticalAlignment="Center" />

            <Button x:Name="MenuButton" Grid.Column="1" Height="28" Padding="8,0" VerticalAlignment="Center"
                    Background="Transparent" BorderThickness="0" CornerRadius="6" ToolTipService.ToolTip="Menu (Alt, M)" AccessKey="M">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Menu" FontSize="12" VerticalAlignment="Center" />
                    <FontIcon Glyph="&#xE70D;" FontSize="8" VerticalAlignment="Center" Opacity="0.7" />
                </StackPanel>
                <Button.Flyout>
                    <MenuFlyout x:Name="AppMenu" Placement="BottomEdgeAlignedLeft" Opening="AppMenu_Opening">
                        <MenuFlyoutItem Text="Open..." Click="Open_Click" AccessKey="O" KeyboardAcceleratorTextOverride="Ctrl+O">
                            <MenuFlyoutItem.Icon><ImageIcon Source="{ThemeResource Icon.open}" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSubItem x:Name="RecentMenu" Text="Open recent" AccessKey="R">
                            <MenuFlyoutSubItem.Icon><ImageIcon Source="{ThemeResource Icon.recent}" /></MenuFlyoutSubItem.Icon>
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSubItem Text="Create" AccessKey="N">
                            <MenuFlyoutSubItem.Icon><ImageIcon Source="{ThemeResource Icon.create}" /></MenuFlyoutSubItem.Icon>
                            <MenuFlyoutItem Text="PDF from images..." Click="ImagesToPdf_Click">
                                <MenuFlyoutItem.Icon><ImageIcon Source="{ThemeResource Icon.append-images}" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Merge PDFs..." Click="MergePdfs_Click">
                                <MenuFlyoutItem.Icon><ImageIcon Source="{ThemeResource Icon.merge}" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="SaveItem" Text="Save" Tag="Save" AccessKey="S" Click="DocCommand_Click" KeyboardAcceleratorTextOverride="Ctrl+S">
                            <MenuFlyoutItem.Icon><ImageIcon Source="{ThemeResource Icon.save}" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="SaveAsItem" Text="Save as..." Tag="SaveAs" AccessKey="A" Click="DocCommand_Click" KeyboardAcceleratorTextOverride="Ctrl+Shift+S">
                            <MenuFlyoutItem.Icon><ImageIcon Source="{ThemeResource Icon.save}" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="PrintItem" Text="Print..." Tag="Print" AccessKey="P" Click="DocCommand_Click" KeyboardAcceleratorTextOverride="Ctrl+P">
                            <MenuFlyoutItem.Icon><ImageIcon Source="{ThemeResource Icon.print}" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSubItem x:Name="ConvertMenu" Text="Convert" AccessKey="C">
                            <MenuFlyoutSubItem.Icon><ImageIcon Source="{ThemeResource Icon.convert}" /></MenuFlyoutSubItem.Icon>
                            <MenuFlyoutItem Text="Make searchable (OCR)" Tag="Ocr" Click="DocCommand_Click">
                                <MenuFlyoutItem.Icon><ImageIcon Source="{ThemeResource Icon.ocr}" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Extract text" Tag="ExtractText" Click="DocCommand_Click">
                                <MenuFlyoutItem.Icon><ImageIcon Source="{ThemeResource Icon.extract-text}" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Export to Word..." Tag="ExportWord" Click="DocCommand_Click">
                                <MenuFlyoutItem.Icon><ImageIcon Source="{ThemeResource Icon.word}" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Export to text..." Tag="ExportText" Click="DocCommand_Click">
                                <MenuFlyoutItem.Icon><ImageIcon Source="{ThemeResource Icon.text}" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Export pages as PNG..." Tag="ExportPng" Click="DocCommand_Click">
                                <MenuFlyoutItem.Icon><ImageIcon Source="{ThemeResource Icon.images}" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Export pages as JPEG..." Tag="ExportJpeg" Click="DocCommand_Click">
                                <MenuFlyoutItem.Icon><ImageIcon Source="{ThemeResource Icon.images}" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Append PDF..." Tag="AppendPdf" Click="DocCommand_Click">
                                <MenuFlyoutItem.Icon><ImageIcon Source="{ThemeResource Icon.merge}" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Append images..." Tag="AppendImages" Click="DocCommand_Click">
                                <MenuFlyoutItem.Icon><ImageIcon Source="{ThemeResource Icon.append-images}" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyoutSubItem>
                        <MenuFlyoutItem x:Name="RemovePasswordItem" Text="Remove password and restrictions..." AccessKey="W" Tag="RemovePassword" Click="DocCommand_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE785;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="PropertiesItem" Text="Properties" Tag="Properties" AccessKey="I" Click="DocCommand_Click" KeyboardAcceleratorTextOverride="Ctrl+D">
                            <MenuFlyoutItem.Icon><ImageIcon Source="{ThemeResource Icon.properties}" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Full screen" Click="FullScreen_Click" AccessKey="F" KeyboardAcceleratorTextOverride="F11">
                            <MenuFlyoutItem.Icon><ImageIcon Source="{ThemeResource Icon.fullscreen}" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Keyboard shortcuts" Click="Shortcuts_Click" AccessKey="K" KeyboardAcceleratorTextOverride="F1">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE765;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Settings" Click="Settings_Click" AccessKey="G">
                            <MenuFlyoutItem.Icon><ImageIcon Source="{ThemeResource Icon.settings}" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>

            <!-- Compact document tabs (built in code); they shrink and scroll instead of running under the caption buttons. -->
            <ScrollViewer x:Name="TabScroller" Grid.Column="2" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" Margin="4,0,0,0">
                <StackPanel x:Name="TabStrip" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" />
            </ScrollViewer>
            <Button x:Name="NewTabButton" Grid.Column="3" Style="{StaticResource TitleBarButtonStyle}" ToolTipService.ToolTip="Open a PDF (Ctrl+O)" Click="Open_Click">
                <FontIcon Glyph="&#xE710;" FontSize="12" />
            </Button>
        </Grid>

        <!-- Open documents; only the active one is visible. -->
        <Grid x:Name="DocumentHost" Grid.Row="1" />

        <!-- Home: shown when no document is open. -->
        <ScrollViewer x:Name="HomePanel" Grid.Row="1">
            <StackPanel MaxWidth="720" Margin="32,56,32,32" Spacing="28" HorizontalAlignment="Center">
                <StackPanel Spacing="6">
                    <Image Source="ms-appx:///Assets/AppLogo.png" Width="64" Height="64" HorizontalAlignment="Left" />
                    <TextBlock Text="VisaryPDF" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="Read, fill, sign, comment and convert PDFs. Scanned pages become searchable with the OCR built into Windows."
                               Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
                <!-- The cards wrap onto more rows in a narrow window. -->
                <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="222" ItemHeight="128">
                    <Button Style="{StaticResource HomeCardButtonStyle}" Click="Open_Click">
                        <StackPanel Spacing="10">
                            <local:AppIcon Icon="open" Size="32" HorizontalAlignment="Left" />
                            <TextBlock Text="Open PDF" FontWeight="SemiBold" />
                            <TextBlock Text="Or drop files here" Opacity="0.65" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource HomeCardButtonStyle}" Click="ImagesToPdf_Click">
                        <StackPanel Spacing="10">
                            <local:AppIcon Icon="create" Size="32" HorizontalAlignment="Left" />
                            <TextBlock Text="Images to PDF" FontWeight="SemiBold" />
                            <TextBlock Text="JPG, PNG, TIFF, HEIC" Opacity="0.65" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource HomeCardButtonStyle}" Click="MergePdfs_Click">
                        <StackPanel Spacing="10">
                            <local:AppIcon Icon="merge" Size="32" HorizontalAlignment="Left" />
                            <TextBlock Text="Merge PDFs" FontWeight="SemiBold" />
                            <TextBlock Text="Combine files into one" Opacity="0.65" FontSize="12" />
                        </StackPanel>
                    </Button>
                </VariableSizedWrapGrid>
                <StackPanel x:Name="RecentSection" Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <local:AppIcon Icon="recent" Size="16" />
                        <TextBlock Text="Recent" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel x:Name="RecentList" Spacing="2" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Settings page, shown over the content area. -->
        <Grid x:Name="SettingsHost" Grid.Row="1" Visibility="Collapsed" Background="{ThemeResource VisyaWindowBrush}" />

        <InfoBar x:Name="ErrorBar" Grid.Row="1" Severity="Error" IsOpen="False" VerticalAlignment="Bottom"
                 HorizontalAlignment="Center" Margin="16" MaxWidth="640" />
    </Grid>
</Window>
