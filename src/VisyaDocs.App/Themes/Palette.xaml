<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      VisaryPDF colors. Light is a soft grey (never stark white) to reduce eye strain.
      Dark is the Windows style dark grey. The Black theme (PaletteBlack.xaml) overrides Dark
      with pure black when selected.
      Besides our own Visya* brushes, common WinUI brushes are overridden so built-in
      controls (tabs, dialogs, flyouts, buttons, text boxes) follow the same palette.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="VisyaWindowColor">#E6E6E6</Color>
            <Color x:Key="VisyaCanvasColor">#D9D9D9</Color>
            <Color x:Key="VisyaPaneColor">#EDEDED</Color>
            <Color x:Key="VisyaToolbarColor">#E0E0E0</Color>
            <Color x:Key="VisyaControlColor">#F0F0F0</Color>
            <Color x:Key="VisyaHoverColor">#D4D4D4</Color>
            <Color x:Key="VisyaBorderColor">#CFCFCF</Color>
            <Color x:Key="VisyaTextColor">#1E1E1E</Color>
            <Color x:Key="VisyaSubtleTextColor">#5C5C5C</Color>

            <SolidColorBrush x:Key="VisyaWindowBrush" Color="{StaticResource VisyaWindowColor}" />
            <SolidColorBrush x:Key="VisyaCanvasBrush" Color="{StaticResource VisyaCanvasColor}" />
            <SolidColorBrush x:Key="VisyaPaneBrush" Color="{StaticResource VisyaPaneColor}" />
            <SolidColorBrush x:Key="VisyaToolbarBrush" Color="{StaticResource VisyaToolbarColor}" />
            <SolidColorBrush x:Key="VisyaHoverBrush" Color="{StaticResource VisyaHoverColor}" />
            <SolidColorBrush x:Key="VisyaBorderBrush" Color="{StaticResource VisyaBorderColor}" />
            <SolidColorBrush x:Key="VisyaTextBrush" Color="{StaticResource VisyaTextColor}" />
            <SolidColorBrush x:Key="VisyaSubtleTextBrush" Color="{StaticResource VisyaSubtleTextColor}" />
            <SolidColorBrush x:Key="VisyaAccentBrush" Color="#2B6FE0" />
            <SolidColorBrush x:Key="VisyaSelectionBrush" Color="#552B7FFF" />
            <SolidColorBrush x:Key="VisyaSearchHitBrush" Color="#66FFB900" />
            <SolidColorBrush x:Key="VisyaSearchCurrentBrush" Color="#99FF7A00" />
            <SolidColorBrush x:Key="VisyaPageShadowBrush" Color="#33000000" />

            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="{StaticResource VisyaWindowColor}" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource VisyaWindowColor}" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{StaticResource VisyaPaneColor}" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource VisyaPaneColor}" />
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource VisyaTextColor}" />
            <SolidColorBrush x:Key="TabViewBackground" Color="{StaticResource VisyaWindowColor}" />
            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="{StaticResource VisyaToolbarColor}" />
            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPointerOver" Color="{StaticResource VisyaHoverColor}" />
            <SolidColorBrush x:Key="ContentDialogBackground" Color="{StaticResource VisyaPaneColor}" />
            <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="{StaticResource VisyaPaneColor}" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="{StaticResource VisyaPaneColor}" />
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource VisyaControlColor}" />
            <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#F7F7F7" />
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="{StaticResource VisyaHoverColor}" />
            <SolidColorBrush x:Key="ButtonBackground" Color="{StaticResource VisyaControlColor}" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource VisyaHoverColor}" />
            <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="{StaticResource VisyaHoverColor}" />
            <!-- Checked tools: a soft tint instead of solid accent, so the colored icon stays readable. -->
            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#DCE5F3" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#D2DCEE" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#C7D3EA" />
            <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{StaticResource VisyaTextColor}" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="{StaticResource VisyaTextColor}" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="{StaticResource VisyaTextColor}" />
            <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="VisyaAccentBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="VisyaAccentBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="VisyaAccentBrush" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource VisyaControlColor}" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{StaticResource VisyaHoverColor}" />
            <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource VisyaControlColor}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{StaticResource VisyaHoverColor}" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#F7F7F7" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <Color x:Key="VisyaWindowColor">#202020</Color>
            <Color x:Key="VisyaCanvasColor">#1A1A1A</Color>
            <Color x:Key="VisyaPaneColor">#2B2B2B</Color>
            <Color x:Key="VisyaToolbarColor">#2D2D2D</Color>
            <Color x:Key="VisyaControlColor">#333333</Color>
            <Color x:Key="VisyaHoverColor">#383838</Color>
            <Color x:Key="VisyaBorderColor">#3D3D3D</Color>
            <Color x:Key="VisyaTextColor">#F0F0F0</Color>
            <Color x:Key="VisyaSubtleTextColor">#A8A8A8</Color>

            <SolidColorBrush x:Key="VisyaWindowBrush" Color="{StaticResource VisyaWindowColor}" />
            <SolidColorBrush x:Key="VisyaCanvasBrush" Color="{StaticResource VisyaCanvasColor}" />
            <SolidColorBrush x:Key="VisyaPaneBrush" Color="{StaticResource VisyaPaneColor}" />
            <SolidColorBrush x:Key="VisyaToolbarBrush" Color="{StaticResource VisyaToolbarColor}" />
            <SolidColorBrush x:Key="VisyaHoverBrush" Color="{StaticResource VisyaHoverColor}" />
            <SolidColorBrush x:Key="VisyaBorderBrush" Color="{StaticResource VisyaBorderColor}" />
            <SolidColorBrush x:Key="VisyaTextBrush" Color="{StaticResource VisyaTextColor}" />
            <SolidColorBrush x:Key="VisyaSubtleTextBrush" Color="{StaticResource VisyaSubtleTextColor}" />
            <SolidColorBrush x:Key="VisyaAccentBrush" Color="#6EA2FF" />
            <SolidColorBrush x:Key="VisyaSelectionBrush" Color="#665A9BFF" />
            <SolidColorBrush x:Key="VisyaSearchHitBrush" Color="#66FFB900" />
            <SolidColorBrush x:Key="VisyaSearchCurrentBrush" Color="#AAFF7A00" />
            <SolidColorBrush x:Key="VisyaPageShadowBrush" Color="#00000000" />

            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="{StaticResource VisyaWindowColor}" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource VisyaWindowColor}" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{StaticResource VisyaPaneColor}" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource VisyaPaneColor}" />
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource VisyaTextColor}" />
            <SolidColorBrush x:Key="TabViewBackground" Color="{StaticResource VisyaWindowColor}" />
            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="{StaticResource VisyaToolbarColor}" />
            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPointerOver" Color="{StaticResource VisyaHoverColor}" />
            <SolidColorBrush x:Key="ContentDialogBackground" Color="{StaticResource VisyaPaneColor}" />
            <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="{StaticResource VisyaPaneColor}" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="{StaticResource VisyaPaneColor}" />
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource VisyaControlColor}" />
            <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#1E1E1E" />
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="{StaticResource VisyaHoverColor}" />
            <SolidColorBrush x:Key="ButtonBackground" Color="{StaticResource VisyaControlColor}" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource VisyaHoverColor}" />
            <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="{StaticResource VisyaHoverColor}" />
            <!-- Checked tools: a soft tint instead of solid accent, so the colored icon stays readable. -->
            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#35404F" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#3C4859" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#303A48" />
            <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{StaticResource VisyaTextColor}" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="{StaticResource VisyaTextColor}" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="{StaticResource VisyaTextColor}" />
            <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="VisyaAccentBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="VisyaAccentBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="VisyaAccentBrush" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource VisyaControlColor}" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{StaticResource VisyaHoverColor}" />
            <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource VisyaControlColor}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{StaticResource VisyaHoverColor}" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1E1E1E" />
        </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
