    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Command icons: glyphs from the icon font built into Windows (Segoe Fluent Icons on
      Windows 11, Segoe MDL2 Assets on Windows 10), so they add nothing to the app size and
      match the system. FontIcon picks the right font through SymbolThemeFontFamily.
    -->
