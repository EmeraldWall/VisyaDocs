<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <!-- Folder build: a plain folder with VisaryPDF.exe, nothing to install. -->
    <WindowsPackageType>None</WindowsPackageType>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- Native AOT: no JIT, fast start, small footprint. -->
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <OptimizationPreference>Size</OptimizationPreference>
    <PublishReadyToRun>false</PublishReadyToRun>
    <!-- Ship without debug symbols (the app's own PDB alone is tens of MB). -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishDir>..\..\artifacts\VisaryPDF-win-x64\</PublishDir>
  </PropertyGroup>
</Project>
