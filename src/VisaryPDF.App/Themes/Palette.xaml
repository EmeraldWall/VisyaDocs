<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      VisaryPDF colors. Light is a soft grey (never stark white) to reduce eye strain.
      Dark is the Windows style dark grey. The Black theme (PaletteBlack.xaml) overrides Dark
      with pure black when selected.
      Besides our own Visary* brushes, common WinUI brushes are overridden so built-in
      controls (tabs, dialogs, flyouts, buttons, text boxes) follow the same palette.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="VisaryWindowColor">#E6E6E6</Color>
            <Color x:Key="VisaryCanvasColor">#D9D9D9</Color>
            <Color x:Key="VisaryPaneColor">#EDEDED</Color>
            <Color x:Key="VisaryToolbarColor">#E0E0E0</Color>
            <Color x:Key="VisaryControlColor">#F0F0F0</Color>
            <Color x:Key="VisaryHoverColor">#D4D4D4</Color>
            <Color x:Key="VisaryBorderColor">#CFCFCF</Color>
            <Color x:Key="VisaryTextColor">#1E1E1E</Color>
            <Color x:Key="VisarySubtleTextColor">#5C5C5C</Color>

            <SolidColorBrush x:Key="VisaryWindowBrush" Color="{StaticResource VisaryWindowColor}" />
            <SolidColorBrush x:Key="VisaryCanvasBrush" Color="{StaticResource VisaryCanvasColor}" />
            <SolidColorBrush x:Key="VisaryPaneBrush" Color="{StaticResource VisaryPaneColor}" />
            <SolidColorBrush x:Key="VisaryToolbarBrush" Color="{StaticResource VisaryToolbarColor}" />
            <SolidColorBrush x:Key="VisaryHoverBrush" Color="{StaticResource VisaryHoverColor}" />
            <SolidColorBrush x:Key="VisaryBorderBrush" Color="{StaticResource VisaryBorderColor}" />
            <SolidColorBrush x:Key="VisaryTextBrush" Color="{StaticResource VisaryTextColor}" />
            <SolidColorBrush x:Key="VisarySubtleTextBrush" Color="{StaticResource VisarySubtleTextColor}" />
            <SolidColorBrush x:Key="VisaryAccentBrush" Color="#2B6FE0" />
            <SolidColorBrush x:Key="VisarySelectionBrush" Color="#552B7FFF" />
            <SolidColorBrush x:Key="VisarySearchHitBrush" Color="#66FFB900" />
            <SolidColorBrush x:Key="VisarySearchCurrentBrush" Color="#99FF7A00" />
            <SolidColorBrush x:Key="VisaryPageShadowBrush" Color="#33000000" />

            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="{StaticResource VisaryWindowColor}" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource VisaryWindowColor}" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{StaticResource VisaryPaneColor}" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource VisaryPaneColor}" />
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource VisaryTextColor}" />
            <SolidColorBrush x:Key="TabViewBackground" Color="{StaticResource VisaryWindowColor}" />
            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="{StaticResource VisaryToolbarColor}" />
            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPointerOver" Color="{StaticResource VisaryHoverColor}" />
            <SolidColorBrush x:Key="ContentDialogBackground" Color="{StaticResource VisaryPaneColor}" />
            <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="{StaticResource VisaryPaneColor}" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="{StaticResource VisaryPaneColor}" />
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource VisaryControlColor}" />
            <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#F7F7F7" />
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="{StaticResource VisaryHoverColor}" />
            <SolidColorBrush x:Key="ButtonBackground" Color="{StaticResource VisaryControlColor}" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource VisaryHoverColor}" />
            <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="{StaticResource VisaryHoverColor}" />
            <!-- Checked tools: a soft tint instead of solid accent, so the colored icon stays readable. -->
            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#DCE5F3" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#D2DCEE" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#C7D3EA" />
            <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{StaticResource VisaryTextColor}" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="{StaticResource VisaryTextColor}" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="{StaticResource VisaryTextColor}" />
            <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="VisaryAccentBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="VisaryAccentBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="VisaryAccentBrush" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource VisaryControlColor}" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{StaticResource VisaryHoverColor}" />
            <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource VisaryControlColor}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{StaticResource VisaryHoverColor}" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#F7F7F7" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <Color x:Key="VisaryWindowColor">#202020</Color>
            <Color x:Key="VisaryCanvasColor">#1A1A1A</Color>
            <Color x:Key="VisaryPaneColor">#2B2B2B</Color>
            <Color x:Key="VisaryToolbarColor">#2D2D2D</Color>
            <Color x:Key="VisaryControlColor">#333333</Color>
            <Color x:Key="VisaryHoverColor">#383838</Color>
            <Color x:Key="VisaryBorderColor">#3D3D3D</Color>
            <Color x:Key="VisaryTextColor">#F0F0F0</Color>
            <Color x:Key="VisarySubtleTextColor">#A8A8A8</Color>

            <SolidColorBrush x:Key="VisaryWindowBrush" Color="{StaticResource VisaryWindowColor}" />
            <SolidColorBrush x:Key="VisaryCanvasBrush" Color="{StaticResource VisaryCanvasColor}" />
            <SolidColorBrush x:Key="VisaryPaneBrush" Color="{StaticResource VisaryPaneColor}" />
            <SolidColorBrush x:Key="VisaryToolbarBrush" Color="{StaticResource VisaryToolbarColor}" />
            <SolidColorBrush x:Key="VisaryHoverBrush" Color="{StaticResource VisaryHoverColor}" />
            <SolidColorBrush x:Key="VisaryBorderBrush" Color="{StaticResource VisaryBorderColor}" />
            <SolidColorBrush x:Key="VisaryTextBrush" Color="{StaticResource VisaryTextColor}" />
            <SolidColorBrush x:Key="VisarySubtleTextBrush" Color="{StaticResource VisarySubtleTextColor}" />
            <SolidColorBrush x:Key="VisaryAccentBrush" Color="#6EA2FF" />
            <SolidColorBrush x:Key="VisarySelectionBrush" Color="#665A9BFF" />
            <SolidColorBrush x:Key="VisarySearchHitBrush" Color="#66FFB900" />
            <SolidColorBrush x:Key="VisarySearchCurrentBrush" Color="#AAFF7A00" />
            <SolidColorBrush x:Key="VisaryPageShadowBrush" Color="#00000000" />

            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="{StaticResource VisaryWindowColor}" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource VisaryWindowColor}" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{StaticResource VisaryPaneColor}" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource VisaryPaneColor}" />
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource VisaryTextColor}" />
            <SolidColorBrush x:Key="TabViewBackground" Color="{StaticResource VisaryWindowColor}" />
            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="{StaticResource VisaryToolbarColor}" />
            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPointerOver" Color="{StaticResource VisaryHoverColor}" />
            <SolidColorBrush x:Key="ContentDialogBackground" Color="{StaticResource VisaryPaneColor}" />
            <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="{StaticResource VisaryPaneColor}" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="{StaticResource VisaryPaneColor}" />
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource VisaryControlColor}" />
            <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#1E1E1E" />
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="{StaticResource VisaryHoverColor}" />
            <SolidColorBrush x:Key="ButtonBackground" Color="{StaticResource VisaryControlColor}" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource VisaryHoverColor}" />
            <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="{StaticResource VisaryHoverColor}" />
            <!-- Checked tools: a soft tint instead of solid accent, so the colored icon stays readable. -->
            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#35404F" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#3C4859" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#303A48" />
            <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{StaticResource VisaryTextColor}" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="{StaticResource VisaryTextColor}" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="{StaticResource VisaryTextColor}" />
            <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="VisaryAccentBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="VisaryAccentBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="VisaryAccentBrush" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource VisaryControlColor}" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{StaticResource VisaryHoverColor}" />
            <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource VisaryControlColor}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{StaticResource VisaryHoverColor}" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1E1E1E" />
        </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
